# ------------------------------------------------------------------
# Code Genie — AI provider configuration
# ------------------------------------------------------------------
# Point these at YOUR server-side proxy / backend. Never ship a real
# secret key to the browser: frontend env vars are public, so the key
# must live on a backend that forwards requests to the AI provider.
#
# When VITE_AI_API_BASE_URL is empty, the app runs in demo mode and
# returns realistic sample responses (no network calls). When it points
# at the backend (http://localhost:8000), login/signup use real
# Postgres-backed JWT auth instead of the local fake session.
# ------------------------------------------------------------------
VITE_AI_API_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=code-genie-default
