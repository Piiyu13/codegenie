# ------------------------------------------------------------------
# Code Genie — Python backend (FastAPI + Gemini)
# ------------------------------------------------------------------
# 1. Copy this file to `.env` inside backend/
# 2. Paste your Gemini key from https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------

# Required — Gemini API key (server-side only, never expose to frontend)
GEMINI_API_KEY=

# Optional — Gemini model (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional — port (defaults to 8000)
PORT=8000

# Optional — if set, the frontend must send
#   Authorization: Bearer <BACKEND_API_KEY>
# which is the value of VITE_AI_API_KEY in the frontend .env
BACKEND_API_KEY=

# --- Auth database (Postgres) ---
# Used directly, or composed from POSTGRES_* below when empty.
DATABASE_URL=
POSTGRES_USER=codegenie
POSTGRES_PASSWORD=codegenie
POSTGRES_DB=codegenie
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth sessions (JWT) ---
# Required for real login/signup. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Token lifetime in minutes (default 10080 = 7 days)
JWT_EXPIRE_MINUTES=10080

# Optional — comma-separated extra origins (Vite dev + preview are on by default)
EXTRA_CORS_ORIGINS=
